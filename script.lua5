--[[
    سكربت ناب الضبان (V29 - النسخة النهائية المطلقة)
    ============================================================
    آخر 6 إصلاحات:
    1. GetClosestDab: fallback يفحص IsESPValid لكل هدف.
    2. IsDabByName: يشترط Humanoid أو 3+ BaseParts (يمنع "dab_sword").
    3. SafeDelay: coroutine.status قبل task.cancel.
    4. CleanupAll: PersistentConns في genv (تنظيف الاتصالات القديمة).
    5. DescendantRemoving: فحص شامل قبل كل استخدام.
    6. ApplyVehicleSpeed: SetNetworkOwner ثم GetNetworkOwner، abort إذا ليس LocalPlayer.
    ============================================================
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local IsDestroyed = false
local SessionId = 0
local GlobalConnections = {}

--// [نقطة 4] PersistentConns في genv
local function GetGenv()
    if getgenv then
        local ok, r = pcall(getgenv)
        if ok and r then return r end
    end
    return _G
end
local genv = GetGenv()
local CONN_KEY = "__DabScript_PersistentConns_v29"
local CLEANUP_KEYS = {"__DabScript_v27_Cleanup", "__DabScript_v28_Cleanup", "__DabScript_v29_Cleanup", "__DabScriptCleanup"}

if not genv[CONN_KEY] then genv[CONN_KEY] = {} end
local PersistentConns = genv[CONN_KEY]

-- تنظيف الاتصالات القديمة
for _, c in ipairs(PersistentConns) do
    if c and c.Connected then pcall(function() c:Disconnect() end) end
end
table.clear(PersistentConns)

-- استدعاء دوال التنظيف القديمة
for _, key in ipairs(CLEANUP_KEYS) do
    if genv[key] then pcall(genv[key]); genv[key] = nil end
    if _G[key] and _G[key] ~= genv[key] then pcall(_G[key]); _G[key] = nil end
end

-- تنظيف الواجهات القديمة
for _, name in ipairs({"DabScriptUI", "DabESP_UI"}) do
    local old = PlayerGui:FindFirstChild(name)
    if old then pcall(function() old:Destroy() end) end
end
local oldHF = Workspace:FindFirstChild("LocalDabESP")
if oldHF then pcall(function() oldHF:Destroy() end) end

local function AddConn(conn)
    table.insert(GlobalConnections, conn)
    table.insert(PersistentConns, conn)
    return conn
end

--// SafeDelay
local ScheduledHandles = {}
local function SafeDelay(t, callback)
    local mySession = SessionId
    local handle = { cancelled = false, thread = nil }
    table.insert(ScheduledHandles, handle)
    handle.thread = task.delay(t, function()
        for i = #ScheduledHandles, 1, -1 do
            if ScheduledHandles[i] == handle then table.remove(ScheduledHandles, i); break end
        end
        if handle.cancelled then return end
        if IsDestroyed or SessionId ~= mySession then return end
        callback()
    end)
    return handle
end

--// [نقطة 3] CancelAllScheduledTasks مع status check
local function CancelAllScheduledTasks()
    local handles = ScheduledHandles
    ScheduledHandles = {}
    for _, h in ipairs(handles) do h.cancelled = true end
    for _, h in ipairs(handles) do
        if h.thread then
            local ok, status = pcall(coroutine.status, h.thread)
            if ok and status ~= "dead" then
                pcall(task.cancel, h.thread)
            end
            h.thread = nil
        end
    end
end

local HighlightFolder = Instance.new("Folder")
HighlightFolder.Name = "LocalDabESP"
HighlightFolder.Parent = Workspace

local UIFolder = Instance.new("Folder")
UIFolder.Name = "DabESP_UI"
UIFolder.Parent = PlayerGui

local DAB_TAGS = {"Dab", "Lizard", "DabModel"}
local FALLBACK_NAMES = {"ضب", "dab", "lizard"}
local FILTER_ORDER = {"عادي", "مميز", "نادر", "فاخر", "أسطوري", "خرافي", "خرافي نادر"}
local KNOWN_TYPES = FILTER_ORDER

local Settings = {
    ESPEnabled = true, AimbotEnabled = false, AimbotKey = Enum.KeyCode.E,
    AimbotSmoothness = 0.15, VehicleSpeed = 300, MaxDistance = 1500, Filters = {}
}
for _, v in ipairs(FILTER_ORDER) do Settings.Filters[v] = true end

local ActiveDabs, ESP_Objects, RetryState, PartFailure, PendingRemoval = {}, {}, {}, {}, {}
local AimbotTarget = nil
local CurrentVehicleVel, CurrentVehicleAttachment = nil, nil
local VehicleSpeedSession = 0

local MAX_RETRY = 8
local RETRY_COOLDOWN = 0.5
local REVIVAL_TIMEOUT = 20
local REMOVAL_CHECK_DELAY = 0.15
local PART_FAIL_LIMIT = 3
local FRAMES_PER_FULL_CYCLE = 3
local MAIN_LOOP_INTERVAL = 0.05

local ActiveDabsKeys, KeysDirty, ProcessCursor = {}, true, 1
local lastMainLoopTick = 0

local function MarkKeysDirty() KeysDirty = true end
local function SetActiveDab(obj, dt) ActiveDabs[obj] = dt; MarkKeysDirty() end

local function GetPartFailure(obj)
    local s = PartFailure[obj]
    if not s then s = {failCount = 0, nextCheckAt = 0}; PartFailure[obj] = s end
    return s
end
local function MarkPartSuccess(obj) PartFailure[obj] = nil end
local function MarkPartFailure(obj)
    local s = GetPartFailure(obj)
    s.failCount = s.failCount + 1
    s.nextCheckAt = tick() + RETRY_COOLDOWN
    return s.failCount
end

local TypeColors = {
    ["عادي"] = Color3.fromRGB(150, 150, 150), ["مميز"] = Color3.fromRGB(0, 255, 0),
    ["نادر"] = Color3.fromRGB(0, 100, 255), ["فاخر"] = Color3.fromRGB(150, 0, 255),
    ["أسطوري"] = Color3.fromRGB(255, 215, 0), ["خرافي"] = Color3.fromRGB(255, 0, 0),
    ["خرافي نادر"] = Color3.fromRGB(255, 0, 255)
}

local function isTashkeel(cp) return cp >= 0x064B and cp <= 0x0652 end
local function isArabicBasicLetter(cp) return cp >= 0x0621 and cp <= 0x064A end
local function normalizeArabicChar(cp)
    if cp == 0x0623 or cp == 0x0625 or cp == 0x0622 then return 0x0627 end
    if cp == 0x0629 then return 0x0647 end
    if cp == 0x0649 then return 0x064A end
    return cp
end
local function NormalizeName(name)
    if not name or name == "" then return " " end
    local chars = {}
    local ok = pcall(function()
        for _, cp in utf8.codes(name) do
            if not isTashkeel(cp) then
                cp = normalizeArabicChar(cp)
                local isAlnum = (cp >= 0x30 and cp <= 0x39) or (cp >= 0x41 and cp <= 0x5A) or
                                (cp >= 0x61 and cp <= 0x7A) or isArabicBasicLetter(cp)
                if isAlnum then
                    if cp >= 0x41 and cp <= 0x5A then cp = cp + 0x20 end
                    table.insert(chars, utf8.char(cp))
                else table.insert(chars, " ") end
            end
        end
    end)
    if not ok then return " " .. (string.lower(name):gsub("[^%w]", " ")) .. " " end
    return " " .. (table.concat(chars):gsub("%s+", " ")) .. " "
end

local function IsTargetConfirmed(obj)
    if not obj or not obj.Parent then return false end
    for _, tag in ipairs(DAB_TAGS) do
        if CollectionService:HasTag(obj, tag) then return true end
    end
    return obj:GetAttribute("IsDab") == true
end

--// [نقطة 2] IsDabByName يشترط Humanoid أو 3+ BaseParts
local function IsDabByName(obj)
    if not obj or not obj.Parent then return false end
    if not obj:IsA("Model") then return false end
    local n = NormalizeName(obj.Name)
    local matched = false
    for _, name in ipairs(FALLBACK_NAMES) do
        if string.find(n, NormalizeName(name), 1, true) then matched = true; break end
    end
    if not matched then return false end
    -- Humanoid = دليل قوي
    if obj:FindFirstChildOfClass("Humanoid") then return true end
    -- أو 3+ BaseParts = موديل معقد يشبه الهدف
    local parts = 0
    for _, c in ipairs(obj:GetChildren()) do
        if c:IsA("BasePart") then
            parts = parts + 1
            if parts >= 3 then return true end
        end
    end
    return false
end

local function IsDab(obj) return IsTargetConfirmed(obj) or IsDabByName(obj) end

local function GetDabType(obj)
    local attrType = obj:GetAttribute("DabType") or obj:GetAttribute("Type")
    if type(attrType) == "string" and attrType ~= "" then
        local na = NormalizeName(attrType)
        for _, kt in ipairs(KNOWN_TYPES) do
            if na == NormalizeName(kt) then return kt end
        end
    end
    local n = NormalizeName(obj.Name)
    if string.find(n, " mythic rare ", 1, true) then return "خرافي نادر" end
    if string.find(n, " mythic ", 1, true) then return "خرافي" end
    if string.find(n, " legendary ", 1, true) then return "أسطوري" end
    if string.find(n, " epic ", 1, true) then return "فاخر" end
    if string.find(n, " rare ", 1, true) then return "نادر" end
    if string.find(n, " uncommon ", 1, true) then return "مميز" end
    if string.find(n, " common ", 1, true) or string.find(n, " normal ", 1, true) then return "عادي" end
    if string.find(n, NormalizeName("خرافي نادر"), 1, true) then return "خرافي نادر" end
    if string.find(n, NormalizeName("خرافي"), 1, true) then return "خرافي" end
    if string.find(n, NormalizeName("أسطوري"), 1, true) then return "أسطوري" end
    if string.find(n, NormalizeName("فاخر"), 1, true) then return "فاخر" end
    if string.find(n, NormalizeName("نادر"), 1, true) then return "نادر" end
    if string.find(n, NormalizeName("مميز"), 1, true) then return "مميز" end
    if string.find(n, NormalizeName("عادي"), 1, true) then return "عادي" end
    -- IsTargetConfirmed فقط يعطي "عادي" (وليس الاسم المجرد، لأن IsDabByName صار مشروطاً)
    if IsTargetConfirmed(obj) then return "عادي" end
    if IsDabByName(obj) then return "عادي" end
    return nil
end

local function FindDabAncestor(obj)
    local cur = obj
    while cur and cur ~= Workspace do
        if IsDab(cur) then return cur end
        cur = cur.Parent
    end
    return nil
end

local PART_PRIORITY = {"HumanoidRootPart", "Head", "Torso", "UpperTorso", "LowerTorso"}
local function GetModelPart(model, ignoredObj)
    if not model then return nil end
    local function ok(p)
        if not p or p == ignoredObj then return false end
        if not p:IsA("BasePart") then return false end
        if not p:IsDescendantOf(model) then return false end
        if not p:IsDescendantOf(Workspace) then return false end
        if ignoredObj and p:IsDescendantOf(ignoredObj) then return false end
        return true
    end
    if model:IsA("BasePart") then return ok(model) and model or nil end
    if not model:IsA("Model") then return nil end
    if model.PrimaryPart and ok(model.PrimaryPart) then return model.PrimaryPart end
    for _, pn in ipairs(PART_PRIORITY) do
        local f = model:FindFirstChild(pn, true)
        if f and ok(f) then return f end
    end
    for _, c in pairs(model:GetDescendants()) do
        if c:IsA("BasePart") and ok(c) then return c end
    end
    return nil
end

local function RemoveESP(obj)
    local esp = ESP_Objects[obj]
    if esp then
        if esp.Highlight then esp.Highlight:Destroy() end
        if esp.Billboard then esp.Billboard:Destroy() end
        ESP_Objects[obj] = nil
    end
end

local function IsESPValid(obj)
    if IsDestroyed or not obj or not obj.Parent then return false end
    if not ActiveDabs[obj] or not obj:IsDescendantOf(Workspace) then return false end
    local esp = ESP_Objects[obj]
    if not esp then return false end
    if not esp.Highlight or not esp.Highlight.Parent then return false end
    if not esp.Billboard or not esp.Billboard.Parent then return false end
    if not esp.Highlight:IsDescendantOf(HighlightFolder) then return false end
    if not esp.Billboard:IsDescendantOf(UIFolder) then return false end
    local p = esp.CachedPart
    if not p or not p.Parent or not p:IsDescendantOf(Workspace) then return false end
    if not p:IsDescendantOf(obj) then return false end
    if esp.Highlight.Adornee ~= obj then return false end
    if esp.Billboard.Adornee ~= p then return false end
    return true
end

local function GetPlayerPos()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then return char.HumanoidRootPart.Position end
    local cam = Workspace.CurrentCamera
    if cam and cam.Parent then return cam.CFrame.Position end
    return Vector3.zero
end

local function UpdateVisibility(obj, dt)
    local esp = ESP_Objects[obj]
    if not esp or not esp.Highlight or not esp.Highlight.Parent
       or not esp.Billboard or not esp.Billboard.Parent then return end
    if not Settings.ESPEnabled or not Settings.Filters[dt] then
        esp.Highlight.Enabled = false; esp.Billboard.Enabled = false; return
    end
    local p = esp.CachedPart
    if not p or not p.Parent or not p:IsDescendantOf(Workspace) or not p:IsDescendantOf(obj) then
        esp.Highlight.Enabled = false; esp.Billboard.Enabled = false; return
    end
    local v = (GetPlayerPos() - p.Position).Magnitude <= Settings.MaxDistance
    esp.Highlight.Enabled = v
    esp.Billboard.Enabled = v
end

local function CreateESP(obj, dt)
    if IsDestroyed or not HighlightFolder.Parent or not UIFolder.Parent then return false end
    if ESP_Objects[obj] then RemoveESP(obj) end
    local p = GetModelPart(obj)
    if not p or not obj:IsDescendantOf(Workspace) then return false end

    local h, b, t
    local ok = pcall(function()
        h = Instance.new("Highlight")
        h.Adornee = obj
        h.FillColor = TypeColors[dt] or Color3.new(1,1,1)
        h.FillTransparency = 0.5
        h.OutlineColor = TypeColors[dt] or Color3.new(1,1,1)
        h.Parent = HighlightFolder
        b = Instance.new("BillboardGui")
        b.Adornee = p
        b.Size = UDim2.new(0, 200, 0, 50)
        b.StudsOffset = Vector3.new(0, 3, 0)
        b.AlwaysOnTop = true
        b.Parent = UIFolder
        t = Instance.new("TextLabel")
        t.Size = UDim2.new(1, 0, 1, 0)
        t.BackgroundTransparency = 1
        t.Text = obj.Name .. "\n[" .. dt .. "]"
        t.TextColor3 = TypeColors[dt] or Color3.new(1,1,1)
        t.TextStrokeTransparency = 0
        t.TextScaled = true
        t.Font = Enum.Font.SourceSansBold
        t.Parent = b
    end)

    if IsDestroyed or not ok or not obj:IsDescendantOf(Workspace) or not p:IsDescendantOf(Workspace) then
        if h then h:Destroy() end
        if b then b:Destroy() end
        return false
    end

    ESP_Objects[obj] = {Highlight = h, Billboard = b, CachedPart = p}
    if not IsESPValid(obj) then RemoveESP(obj); return false end
    return true
end

local function TryCreateESP(obj, bypass)
    local dt = ActiveDabs[obj]
    if not dt then return false end
    local now = tick()
    local st = RetryState[obj]

    if bypass then
        if st then st.abandoned = false; st.attempts = 0; st.nextAttemptAt = 0; st.reviveAt = 0 end
    elseif st then
        if st.abandoned then
            if now < st.reviveAt then return false end
            st.abandoned = false; st.attempts = 0; st.nextAttemptAt = 0; st.reviveAt = 0
        elseif now < st.nextAttemptAt then return false end
    end

    if CreateESP(obj, dt) then RetryState[obj] = nil; return true end

    if not st then st = {attempts=0, abandoned=false, nextAttemptAt=0, reviveAt=0}; RetryState[obj] = st end
    st.attempts = st.attempts + 1
    st.nextAttemptAt = now + RETRY_COOLDOWN
    if st.attempts >= MAX_RETRY then
        st.abandoned = true; st.reviveAt = now + REVIVAL_TIMEOUT; st.nextAttemptAt = st.reviveAt
    end
    return false
end

local function RefreshCachedPart(obj, bypass)
    local esp = ESP_Objects[obj]
    if not esp or not esp.Billboard or not esp.Billboard.Parent then return false end
    local now = tick()
    if not bypass then
        local s = PartFailure[obj]
        if s and now < s.nextCheckAt then return false end
    end
    local p = GetModelPart(obj)
    if not p or not p.Parent or not p:IsDescendantOf(Workspace) or not p:IsDescendantOf(obj) then return false end
    esp.CachedPart = p
    esp.Billboard.Adornee = p
    if not p.Parent or not p:IsDescendantOf(Workspace) or not p:IsDescendantOf(obj)
       or esp.Billboard.Adornee ~= p or not esp.Billboard.Parent then
        esp.CachedPart = nil; return false
    end
    local dt = ActiveDabs[obj]
    if dt then UpdateVisibility(obj, dt) end
    return true
end

local function HandleTargetState(obj)
    if IsDestroyed then return end
    if not obj or not obj:IsDescendantOf(Workspace) then
        SetActiveDab(obj, nil); RetryState[obj] = nil; PartFailure[obj] = nil; PendingRemoval[obj] = nil
        RemoveESP(obj); return
    end
    if PendingRemoval[obj] then return end
    local dt = ActiveDabs[obj]
    if not dt then return end
    local esp = ESP_Objects[obj]
    if not esp then TryCreateESP(obj); return end

    if not IsESPValid(obj) then
        if not esp.Highlight or not esp.Highlight.Parent or not esp.Billboard or not esp.Billboard.Parent then
            RemoveESP(obj); RetryState[obj] = nil; PartFailure[obj] = nil
            TryCreateESP(obj, true); return
        end
        esp.Highlight.Enabled = false
        esp.Billboard.Enabled = false
        local s = PartFailure[obj]
        if s and tick() < s.nextCheckAt then return end
        if RefreshCachedPart(obj) then MarkPartSuccess(obj)
        else
            if MarkPartFailure(obj) >= PART_FAIL_LIMIT then
                RemoveESP(obj); RetryState[obj] = nil; PartFailure[obj] = nil
                TryCreateESP(obj, true)
            end
        end
        return
    end
    UpdateVisibility(obj, dt)
end

local function UpdateDabList(obj)
    local anc = FindDabAncestor(obj)
    if not anc or PendingRemoval[anc] then return end
    local dt = GetDabType(anc)
    if dt then
        local changed = (ActiveDabs[anc] == nil) or (ActiveDabs[anc] ~= dt)
        SetActiveDab(anc, dt)
        if changed then
            RetryState[anc] = nil; PartFailure[anc] = nil
            TryCreateESP(anc, true)
        end
    else
        if ActiveDabs[anc] then
            SetActiveDab(anc, nil); RetryState[anc] = nil
            PartFailure[anc] = nil; RemoveESP(anc)
        end
    end
end

AddConn(Workspace.DescendantAdded:Connect(function(obj)
    local capturedObj = obj
    local mySession = SessionId
    SafeDelay(0.1, function()
        if IsDestroyed or SessionId ~= mySession then return end
        if not capturedObj or not capturedObj.Parent or not capturedObj:IsDescendantOf(Workspace) then return end
        UpdateDabList(capturedObj)
    end)
end))

--// [نقطة 5] DescendantRemoving مع فحص شامل
AddConn(Workspace.DescendantRemoving:Connect(function(obj)
    if IsDestroyed then return end
    if ActiveDabs[obj] then
        PendingRemoval[obj] = true
        local captured = obj
        SafeDelay(REMOVAL_CHECK_DELAY, function()
            if IsDestroyed then return end
            if not captured then return end
            -- فحص 1: ما زال في الشجرة؟
            if not captured.Parent or not captured:IsDescendantOf(Workspace) then
                PendingRemoval[captured] = nil
                SetActiveDab(captured, nil); RetryState[captured] = nil; PartFailure[captured] = nil
                RemoveESP(captured); return
            end
            PendingRemoval[captured] = nil
            -- فحص 2: النوع الحالي
            local dt = GetDabType(captured)
            if not dt then
                SetActiveDab(captured, nil); RetryState[captured] = nil; PartFailure[captured] = nil
                RemoveESP(captured); return
            end
            -- فحص 3: الحالة تغيرت؟
            if ActiveDabs[captured] ~= dt then
                SetActiveDab(captured, dt)
                RetryState[captured] = nil; PartFailure[captured] = nil
                RemoveESP(captured)
            end
            -- فحص 4: ESP صالح؟
            if not IsESPValid(captured) then
                RemoveESP(captured); TryCreateESP(captured, true)
            end
        end)
        return
    end
    local cur = obj.Parent
    while cur and cur ~= Workspace do
        if ActiveDabs[cur] and ESP_Objects[cur] then
            local ed = ESP_Objects[cur]
            if obj == ed.Billboard or obj == ed.Highlight then
                RemoveESP(cur); break
            end
            local capturedCur = cur
            SafeDelay(REMOVAL_CHECK_DELAY, function()
                if IsDestroyed then return end
                if not capturedCur or not capturedCur.Parent or not capturedCur:IsDescendantOf(Workspace) then return end
                if not ActiveDabs[capturedCur] or not ESP_Objects[capturedCur] then return end
                if RefreshCachedPart(capturedCur, true) then MarkPartSuccess(capturedCur) end
            end)
            break
        end
        cur = cur.Parent
    end
end))

for _, obj in pairs(Workspace:GetDescendants()) do
    if IsDestroyed then break end
    UpdateDabList(obj)
end

local function UpdateFilters()
    for obj, dt in pairs(ActiveDabs) do UpdateVisibility(obj, dt) end
end

--// [نقطة 1] GetClosestDab: fallback يفحص IsESPValid
local CachedNearestPart, CachedNearestObj = nil, nil
local function GetClosestDab()
    if CachedNearestPart and CachedNearestObj and IsESPValid(CachedNearestObj) then
        return CachedNearestPart
    end
    -- Fallback: فقط الأهداف ذات ESP صالح
    local pp = GetPlayerPos()
    local closest, shortest = nil, math.huge
    for obj, dt in pairs(ActiveDabs) do
        if Settings.Filters[dt] and not PendingRemoval[obj]
           and obj:IsDescendantOf(Workspace)
           and ESP_Objects[obj] and IsESPValid(obj) then
            local p = ESP_Objects[obj].CachedPart
            if p and p.Parent and p:IsDescendantOf(Workspace) and p:IsDescendantOf(obj) then
                local d = (pp - p.Position).Magnitude
                if d < shortest and d <= Settings.MaxDistance then shortest = d; closest = p end
            end
        end
    end
    return closest
end

local function UpdateNearestCache()
    local pp = GetPlayerPos()
    local closest, shortest, cObj = nil, math.huge, nil
    for obj, dt in pairs(ActiveDabs) do
        if Settings.Filters[dt] and not PendingRemoval[obj] and obj:IsDescendantOf(Workspace)
           and ESP_Objects[obj] and IsESPValid(obj) then
            local p = ESP_Objects[obj].CachedPart
            if p and p.Parent and p:IsDescendantOf(Workspace) and p:IsDescendantOf(obj) then
                local d = (pp - p.Position).Magnitude
                if d < shortest and d <= Settings.MaxDistance then shortest = d; closest = p; cObj = obj end
            end
        end
    end
    CachedNearestPart = closest; CachedNearestObj = cObj
end

local function UpdateAimbot()
    local cam = Workspace.CurrentCamera
    if not Settings.AimbotEnabled or not cam or not cam.Parent then return end
    if UserInputService:IsKeyDown(Settings.AimbotKey) then
        AimbotTarget = GetClosestDab()
        if AimbotTarget and AimbotTarget.Parent then
            local cf = CFrame.new(cam.CFrame.Position, AimbotTarget.Position)
            cam.CFrame = cam.CFrame:Lerp(cf, Settings.AimbotSmoothness)
        else AimbotTarget = nil end
    end
end

local function StopVehicleSpeed()
    VehicleSpeedSession = VehicleSpeedSession + 1
    if CurrentVehicleVel then CurrentVehicleVel:Destroy() CurrentVehicleVel = nil end
    if CurrentVehicleAttachment then CurrentVehicleAttachment:Destroy() CurrentVehicleAttachment = nil end
end

--// [نقطة 6] ApplyVehicleSpeed: SetNetworkOwner ثم GetNetworkOwner، abort إذا ليس LocalPlayer
local function ApplyVehicleSpeed()
    local char = LocalPlayer.Character
    if not char then StopVehicleSpeed() return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or not hum.SeatPart then StopVehicleSpeed() return end
    local seat = hum.SeatPart
    if not seat:IsA("VehicleSeat") then StopVehicleSpeed() return end
    local vm = seat:FindFirstAncestorOfClass("Model")
    if not vm then StopVehicleSpeed() return end
    local rp = vm.PrimaryPart or GetModelPart(vm)
    if not rp then StopVehicleSpeed() return end

    -- محاولة فرض الملكية
    pcall(function() rp:SetNetworkOwner(LocalPlayer) end)

    -- التحقق الفعلي
    local ok, owner = pcall(function() return rp:GetNetworkOwner() end)
    if not ok then
        warn("[ناب الضبان] ⚠️ GetNetworkOwner() فشل (قد تكون اللعبة Server-Authoritative).")
        warn("[ناب الضبان] ⚠️ تم إيقاف تطبيق السرعة. الحل: RemoteEvent → ServerScript.")
        StopVehicleSpeed(); return
    end
    if owner ~= LocalPlayer then
        warn("[ناب الضبان] ⚠️ الملكية ليست للاعبك (owner=" .. tostring(owner) .. ").")
        warn("[ناب الضبان] ⚠️ تم إيقاف تطبيق السرعة. الحل: RemoteEvent → ServerScript.")
        StopVehicleSpeed(); return
    end

    -- الملكية مؤكدة للاعب
    StopVehicleSpeed()
    local curS = VehicleSpeedSession
    CurrentVehicleAttachment = Instance.new("Attachment")
    CurrentVehicleAttachment.Name = "DabSpeedAttachment"
    CurrentVehicleAttachment.Parent = rp
    CurrentVehicleVel = Instance.new("LinearVelocity")
    CurrentVehicleVel.Attachment0 = CurrentVehicleAttachment
    CurrentVehicleVel.RelativeTo = Enum.ActuatorRelativeTo.World
    CurrentVehicleVel.VectorVelocity = rp.CFrame.LookVector * Settings.VehicleSpeed
    CurrentVehicleVel.MaxForce = math.huge
    CurrentVehicleVel.ForceLimitsEnabled = true
    CurrentVehicleVel.ForceLimitMode = Enum.ForceLimitMode.Magnitude
    CurrentVehicleVel.MaxAxesForce = Vector3.new(math.huge, math.huge, math.huge)
    CurrentVehicleVel.Parent = rp
    SafeDelay(2, function()
        if VehicleSpeedSession == curS then StopVehicleSpeed() end
    end)
end

AddConn(LocalPlayer.CharacterAdded:Connect(function(c)
    if IsDestroyed then return end
    AimbotTarget = nil; StopVehicleSpeed()
    c:WaitForChild("HumanoidRootPart", 5)
end))

local function CleanupAll()
    if IsDestroyed then return end
    IsDestroyed = true
    SessionId = SessionId + 1
    CancelAllScheduledTasks()
    for _, c in ipairs(GlobalConnections) do if c.Connected then pcall(function() c:Disconnect() end) end end
    table.clear(GlobalConnections)
    StopVehicleSpeed()
    for obj in pairs(ESP_Objects) do RemoveESP(obj) end
    table.clear(ActiveDabs); table.clear(ESP_Objects); table.clear(RetryState)
    table.clear(PartFailure); table.clear(PendingRemoval); table.clear(ActiveDabsKeys)
    AimbotTarget = nil; CachedNearestPart = nil; CachedNearestObj = nil
    local ui = PlayerGui:FindFirstChild("DabScriptUI")
    if ui then ui:Destroy() end
    if UIFolder then UIFolder:Destroy() end
    if HighlightFolder then HighlightFolder:Destroy() end
    -- تنظيف PersistentConns و genv
    table.clear(PersistentConns)
    for _, key in ipairs(CLEANUP_KEYS) do
        if genv[key] == CleanupAll then genv[key] = nil end
        if _G[key] == CleanupAll then _G[key] = nil end
    end
end

for _, key in ipairs(CLEANUP_KEYS) do genv[key] = CleanupAll end

local function CreateGUI()
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "DabScriptUI"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.Parent = PlayerGui

    local MainFrame = Instance.new("Frame")
    MainFrame.Size = UDim2.new(0, 250, 0, 450)
    MainFrame.Position = UDim2.new(0.5, -125, 0.4, -200)
    MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    MainFrame.BackgroundTransparency = 0.1
    MainFrame.BorderSizePixel = 2
    MainFrame.BorderColor3 = Color3.fromRGB(0, 255, 0)
    MainFrame.Active = true
    MainFrame.Parent = ScreenGui
    TweenService:Create(MainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back), {Position = UDim2.new(0.5, -125, 0.4, -200)}):Play()

    local dragging, dragInput, dragStart, startPos
    AddConn(MainFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = MainFrame.Position
            AddConn(input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end))
        end
    end))
    AddConn(MainFrame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end))
    AddConn(UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local d = input.Position - dragStart
            MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end))

    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, 0, 0, 35)
    Title.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
    Title.Text = "ناب الضبان - V29"
    Title.TextColor3 = Color3.new(1,1,1)
    Title.Font = Enum.Font.SourceSansBold
    Title.TextScaled = true
    Title.Parent = MainFrame

    local CloseBtn = Instance.new("TextButton")
    CloseBtn.Size = UDim2.new(0, 30, 0, 30)
    CloseBtn.Position = UDim2.new(1, -35, 0, 2)
    CloseBtn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
    CloseBtn.Text = "X"
    CloseBtn.TextColor3 = Color3.new(1,1,1)
    CloseBtn.Font = Enum.Font.SourceSansBold
    CloseBtn.Parent = Title
    AddConn(CloseBtn.MouseButton1Click:Connect(CleanupAll))

    local ESPBtn = Instance.new("TextButton")
    ESPBtn.Size = UDim2.new(0.45, 0, 0, 30)
    ESPBtn.Position = UDim2.new(0.05, 0, 0.12, 0)
    ESPBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
    ESPBtn.Text = "ESP: مفعل"
    ESPBtn.TextColor3 = Color3.new(1,1,1)
    ESPBtn.Parent = MainFrame
    AddConn(ESPBtn.MouseButton1Click:Connect(function()
        Settings.ESPEnabled = not Settings.ESPEnabled
        ESPBtn.Text = Settings.ESPEnabled and "ESP: مفعل" or "ESP: معطل"
        ESPBtn.BackgroundColor3 = Settings.ESPEnabled and Color3.fromRGB(0,150,0) or Color3.fromRGB(150,0,0)
        UpdateFilters()
    end))

    local AimbotBtn = Instance.new("TextButton")
    AimbotBtn.Size = UDim2.new(0.45, 0, 0, 30)
    AimbotBtn.Position = UDim2.new(0.5, 0, 0.12, 0)
    AimbotBtn.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
    AimbotBtn.Text = "Aimbot: معطل"
    AimbotBtn.TextColor3 = Color3.new(1,1,1)
    AimbotBtn.Parent = MainFrame
    AddConn(AimbotBtn.MouseButton1Click:Connect(function()
        Settings.AimbotEnabled = not Settings.AimbotEnabled
        AimbotBtn.Text = Settings.AimbotEnabled and "Aimbot: مفعل" or "Aimbot: معطل"
        AimbotBtn.BackgroundColor3 = Settings.AimbotEnabled and Color3.fromRGB(0,150,0) or Color3.fromRGB(150,0,0)
    end))

    local typeFrame = Instance.new("ScrollingFrame")
    typeFrame.Size = UDim2.new(1, -20, 0, 150)
    typeFrame.Position = UDim2.new(0, 10, 0.22, 0)
    typeFrame.BackgroundTransparency = 1
    typeFrame.BorderSizePixel = 0
    typeFrame.ScrollBarThickness = 4
    typeFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
    typeFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    typeFrame.Parent = MainFrame

    local grid = Instance.new("UIGridLayout")
    grid.CellSize = UDim2.new(0.48, 0, 0, 25)
    grid.CellPadding = UDim2.new(0.02, 0, 0, 3)
    grid.SortOrder = Enum.SortOrder.LayoutOrder
    grid.Parent = typeFrame

    for i, name in ipairs(FILTER_ORDER) do
        local b = Instance.new("TextButton")
        b.LayoutOrder = i
        b.BackgroundColor3 = TypeColors[name]
        b.Text = name
        b.TextColor3 = Color3.new(1,1,1)
        b.Font = Enum.Font.SourceSansBold
        b.TextScaled = true
        b.Parent = typeFrame
        AddConn(b.MouseButton1Click:Connect(function()
            Settings.Filters[name] = not Settings.Filters[name]
            b.BackgroundTransparency = Settings.Filters[name] and 0 or 0.6
            UpdateFilters()
        end))
    end

    local SelectAll = Instance.new("TextButton")
    SelectAll.Size = UDim2.new(0.9, 0, 0, 30)
    SelectAll.Position = UDim2.new(0.05, 0, 0.6, 0)
    SelectAll.BackgroundColor3 = Color3.fromRGB(0, 100, 200)
    SelectAll.Text = "تحديد الكل"
    SelectAll.TextColor3 = Color3.new(1,1,1)
    SelectAll.Parent = MainFrame
    AddConn(SelectAll.MouseButton1Click:Connect(function()
        for _, v in ipairs(FILTER_ORDER) do Settings.Filters[v] = true end
        for _, c in pairs(typeFrame:GetChildren()) do
            if c:IsA("TextButton") then c.BackgroundTransparency = 0 end
        end
        UpdateFilters()
    end))

    local SpeedBox = Instance.new("TextBox")
    SpeedBox.Size = UDim2.new(0.5, 0, 0, 30)
    SpeedBox.Position = UDim2.new(0.05, 0, 0.75, 0)
    SpeedBox.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    SpeedBox.Text = tostring(Settings.VehicleSpeed)
    SpeedBox.TextColor3 = Color3.new(1,1,1)
    SpeedBox.Parent = MainFrame

    local SpeedBtn = Instance.new("TextButton")
    SpeedBtn.Size = UDim2.new(0.35, 0, 0, 30)
    SpeedBtn.Position = UDim2.new(0.6, 0, 0.75, 0)
    SpeedBtn.BackgroundColor3 = Color3.fromRGB(200, 150, 0)
    SpeedBtn.Text = "تفعيل السرعة"
    SpeedBtn.TextColor3 = Color3.new(1,1,1)
    SpeedBtn.Parent = MainFrame
    AddConn(SpeedBtn.MouseButton1Click:Connect(function()
        local v = tonumber(SpeedBox.Text)
        if v then
            Settings.VehicleSpeed = math.clamp(v, 10, 1000)
            SpeedBox.Text = tostring(Settings.VehicleSpeed)
            ApplyVehicleSpeed()
        end
    end))

    AddConn(ScreenGui.Destroying:Connect(CleanupAll))
end

AddConn(RunService.RenderStepped:Connect(function()
    if IsDestroyed then return end
    UpdateAimbot()
    local now = tick()
    if now - lastMainLoopTick < MAIN_LOOP_INTERVAL then return end
    lastMainLoopTick = now
    UpdateNearestCache()
    if KeysDirty then
        ActiveDabsKeys = {}
        for obj in pairs(ActiveDabs) do table.insert(ActiveDabsKeys, obj) end
        KeysDirty = false
        if ProcessCursor > #ActiveDabsKeys then ProcessCursor = 1 end
    end
    local total = #ActiveDabsKeys
    if total == 0 then return end
    local bs = math.max(1, math.ceil(total / FRAMES_PER_FULL_CYCLE))
    local e = math.min(ProcessCursor + bs - 1, total)
    for i = ProcessCursor, e do
        if IsDestroyed then break end
        local obj = ActiveDabsKeys[i]
        if obj and ActiveDabs[obj] then HandleTargetState(obj) end
    end
    ProcessCursor = e + 1
    if ProcessCursor > total then ProcessCursor = 1 end
end))

CreateGUI()
